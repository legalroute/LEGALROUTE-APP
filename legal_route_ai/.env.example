# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/legal_ai

# AI and speech (voice intakes and Maya). Set at least one AI key plus Deepgram.
# The provider can be changed on /settings; until then it is LLM_PROVIDER (openai or anthropic) if set,
# otherwise whichever AI key is filled in.
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# Optional: public base URL used in emailed links (defaults to the request's host).
APP_URL=

# Optional: magic-link and notification emails via Resend. Without these, emails are logged
# to the server console and, in development, the sign-in link is shown on screen.
RESEND_API_KEY=
EMAIL_FROM="LegalRoute <login@yourfirm.com>"

# Optional: calendar connections. Redirect URIs to register with each provider:
#   <APP_URL>/api/calendar/google/callback  and  <APP_URL>/api/calendar/calendly/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=

# Optional: Google Sheets datasets. Use a dedicated Web application OAuth client.
# Callback: <APP_URL>/api/connectors/google-sheets/callback
# APP_URL above is required for this connector (http://localhost:3000 locally).
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CONNECTOR_ENCRYPTION_KEY=
