{
  "name": "@legalroute/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "next typegen && tsc --noEmit",
    "eval:intake": "tsx --conditions=react-server evals/intake-accuracy.ts",
    "eval:voice": "tsx --conditions=react-server evals/voice-robustness.ts",
    "test:scheduling": "npm run test --workspace=@legalroute/backend",
    "predev": "npm --prefix .. run build:packages",
    "prebuild": "npm --prefix .. run build:packages"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5",
    "@legalroute/backend": "0.1.0",
    "@legalroute/agents": "0.1.0"
  },
  "devDependencies": {
    "@next/env": "^16.3.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
